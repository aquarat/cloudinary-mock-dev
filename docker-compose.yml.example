services:
  cloudinary-mock-dev:
    build: .
    ports:
      - "33000:3000"
    volumes:
      - cloudinary-data:/data
    environment:
      # CLOUDINARY_CLOUD_NAME: your-cloud-name
      # CLOUDINARY_API_KEY: "your-api-key"
      # CLOUDINARY_API_SECRET: your-api-secret

volumes:
  cloudinary-data:
