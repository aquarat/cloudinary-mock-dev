{
  "name": "cloudinary-mock-dev",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build:web": "bun build web/main.tsx --outdir web/dist --target browser --minify --entry-naming '[dir]/app.[ext]' --define process.env.NODE_ENV='\"production\"'"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "image-size": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
